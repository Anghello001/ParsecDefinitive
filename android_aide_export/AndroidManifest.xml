<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.parsec.gamepadoverlay">

    <!-- Permiso esencial para superposición de ventanas flotantes -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Permiso para ejecutar el servicio en primer plano sin que el sistema lo cierre -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Permisos de red para comunicación WebView y depuración inalámbrica ADB -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Retroalimentación háptica (vibración al pulsar botones) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Visibilidad de paquetes para lanzar Parsec y otros emuladores (Android 11+) -->
    <queries>
        <package android:name="tv.parsec.client" />
        <package android:name="com.limelight" />
        <package android:name="com.valvesoftware.steamlink" />
        <package android:name="com.gamepass" />
        <package android:name="com.retroarch" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true">

        <!-- Actividad Principal para permisos y control -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Servicio de Ventana Flotante (Overlay WebView) -->
        <service
            android:name=".FloatingGamepadService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Servicio de Accesibilidad para inyección de eventos de hardware y toques -->
        <service
            android:name=".GamepadAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
