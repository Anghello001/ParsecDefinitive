#!/bin/sh

# Gradle start up script for POSIX systems
# Compatible with Termux, Linux, macOS, and Android AIDE shell

APP_BASE_NAME=`basename "$0"`

# Attempt to set APP_HOME
# Resolve links: $0 may be a link
PRG="$0"
# Need this for relative symlinks.
while [ -h "$PRG" ] ; do
    ls=`ls -ld "$PRG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG=`dirname "$PRG"`"/$link"
    fi
done
SAVED="`pwd`"
cd "`dirname \"$PRG\"`" >/dev/null
APP_HOME="`pwd -P`"
cd "$SAVED" >/dev/null

# Check if system gradle is installed (Termux / Linux / Mac)
if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
fi

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ ! -f "$CLASSPATH" ]; then
    mkdir -p "$APP_HOME/gradle/wrapper"
    echo "Descargando gradle-wrapper.jar..."
    if command -v curl >/dev/null 2>&1; then
        curl -sLo "$CLASSPATH" "https://raw.githubusercontent.com/gradle/gradle/master/gradle/wrapper/gradle-wrapper.jar" || true
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$CLASSPATH" "https://raw.githubusercontent.com/gradle/gradle/master/gradle/wrapper/gradle-wrapper.jar" || true
    fi
fi

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
else
    JAVACMD="java"
fi

if [ ! -x "$JAVACMD" ] ; then
    which java >/dev/null 2>&1 || {
        echo "Error: JAVA_HOME no está configurado y no se encontró 'java' en el PATH." >&2
        echo "Nota: En AIDE en Android no necesitas ejecutar gradlew por consola. Simplemente abre la carpeta del proyecto en AIDE y toca el botón Play (Run)." >&2
        exit 1
    }
fi

# Execute gradle wrapper
exec "$JAVACMD" "-Dorg.gradle.appname=$APP_BASE_NAME" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
